<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- OnePlus 9 Pro (lemonadep) sources -->
  <remote name="lemonadep"
          fetch="https://github.com/derpfest-lemonadep-oddlyspaced"
          revision="17" />
  <remote name="los-lemonadep"
          fetch="https://github.com/LineageOS"
          revision="refs/heads/lineage-24.0" />
  <remote name="muppets-lemonadep"
          fetch="https://github.com/TheMuppets"
          revision="refs/heads/lineage-24.0" />
  <remote name="togofire"
          fetch="https://github.com/TogoFire"
          revision="refs/heads/v4a" />

  <!-- frameworks/base: DerpFest 17 + lemonadep fixes -->
  <remove-project name="android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="lemonadep" />

  <!-- DerpFestParts: DerpFest 17 + lemonadep settings -->
  <remove-project name="android_packages_apps_DerpFestParts" />
  <project path="packages/apps/DerpFestParts" name="android_packages_apps_DerpFestParts" remote="lemonadep" />
  <!-- ThemePicker: alphabetical font list -->
  <remove-project name="android_packages_apps_ThemePicker" />
  <project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" remote="lemonadep" />
  <!-- fontage: drop the italic duplicate Inter overlay -->
  <remove-project name="android_vendor_fontage" />
  <project path="vendor/fontage" name="android_vendor_fontage" remote="lemonadep" />
  <!-- Settings: link to the on-device summary model -->
  <remove-project name="android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="lemonadep" />
  <!-- On-device notification summaries -->
  <project path="external/llama.cpp" name="android_external_llama.cpp" remote="lemonadep" clone-depth="1" />
  <project path="packages/apps/DerpSummarizer" name="android_packages_apps_DerpSummarizer" remote="lemonadep" />

  <!-- Device trees -->
  <project path="device/oneplus/lemonadep" name="android_device_oneplus_lemonadep" remote="lemonadep" clone-depth="1" />
  <project path="device/oneplus/sm8350-common" name="android_device_oneplus_sm8350-common" remote="lemonadep" clone-depth="1" />

  <!-- Kernel (KernelSU imported in-tree) -->
  <project path="kernel/oneplus/sm8350" name="android_kernel_oneplus_sm8350" remote="lemonadep" clone-depth="1" />

  <!-- Hardware -->
  <project path="hardware/oplus" name="android_hardware_oplus" remote="los-lemonadep" clone-depth="1" />
  <project path="hardware/oneplus" name="android_hardware_oneplus" remote="los-lemonadep" clone-depth="1" />
  <project path="hardware/pixelworks/interfaces" name="android_hardware_pixelworks_interfaces" remote="los-lemonadep" clone-depth="1" />

  <!-- ViPER4AndroidFX (inherited by sm8350-common) -->
  <project path="packages/apps/ViPER4AndroidFX" name="packages_apps_ViPER4AndroidFX" remote="togofire" clone-depth="1" />

  <!-- Proprietary blobs -->
  <project path="vendor/oneplus/lemonadep" name="proprietary_vendor_oneplus_lemonadep" remote="muppets-lemonadep" clone-depth="1" />
  <project path="vendor/oneplus/sm8350-common" name="proprietary_vendor_oneplus_sm8350-common" remote="muppets-lemonadep" clone-depth="1" />
</manifest>
